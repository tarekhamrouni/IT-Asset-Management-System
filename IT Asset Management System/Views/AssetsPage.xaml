<Page x:Class="IT_Asset_Management_System.Views.AssetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">
    

    <Page.Resources>

        <!-- Transparent clickable layer used inside the ComboBox -->
        <Style x:Key="TransparentComboToggleStyle"
               TargetType="ToggleButton">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Border Background="Transparent"/>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="CenteredTextStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>


        <!-- Modern rounded filter dropdown -->
        <Style x:Key="FilterComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="155"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- Closed filter background -->
                            <Border x:Name="ComboBorder"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="7">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected option -->
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,0,0"/>

                                    <!-- Dropdown arrow -->
                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          Fill="#6B7280"
                                          Data="M 0 0 L 8 0 L 4 5 Z"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                                </Grid>
                            </Border>

                            <!-- Clickable transparent layer -->
                            <ToggleButton Style="{StaticResource TransparentComboToggleStyle}"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}"
                                          ClickMode="Press"/>

                            <!-- Open dropdown -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Background="White"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="300"
                                                  VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>
                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">

                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Dropdown options -->
        <Style TargetType="ComboBoxItem">

            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F3F6FB"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#EAF1FF"/>

                                <Setter Property="Foreground"
                                        Value="#2563EB"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Add Asset button -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Table header with sorting arrows -->
        <Style x:Key="ModernHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#EAF1F8"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="DataGridColumnHeader">

                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid Margin="{TemplateBinding Padding}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>

                                <Path x:Name="AscendingArrow"
                                      Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      Fill="#2563EB"
                                      Data="M 0 5 L 4 0 L 8 5 Z"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                <Path x:Name="DescendingArrow"
                                      Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      Fill="#2563EB"
                                      Data="M 0 0 L 4 5 L 8 0 Z"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="SortDirection"
                                     Value="Ascending">

                                <Setter TargetName="AscendingArrow"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="SortDirection"
                                     Value="Descending">

                                <Setter TargetName="DescendingArrow"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="#F1F5F9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Table cells -->
        <Style x:Key="ModernCellStyle"
               TargetType="DataGridCell">

            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="#111827"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Table rows -->
        <Style x:Key="ModernRowStyle"
               TargetType="DataGridRow">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#F9FAFB"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F1F5F9"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E8F0FF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Page.Resources>

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Assets"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Text="Manage and track all company equipment"
                       Margin="0,6,0,18"
                       FontSize="14"
                       Foreground="#6B7280"/>

            <Border Height="1"
                    Background="#E5E7EB"/>

        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1"
              Margin="0,24,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <Border Grid.Column="0"
                    Height="42"
                    Margin="0,0,12,0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="7">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#6B7280"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Column="1">

                        <TextBox x:Name="SearchTextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#111827"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Text="Search in assets..."
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding Text.Length,
                                                                            ElementName=SearchTextBox}"
                                                           Value="0"/>

                                                <Condition Binding="{Binding IsKeyboardFocusWithin,
                                                                            ElementName=SearchTextBox}"
                                                           Value="False"/>

                                            </MultiDataTrigger.Conditions>

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </MultiDataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Grid>

            </Border>

            <!-- Type filter -->
            <ComboBox x:Name="TypeFilterComboBox"
                      Grid.Column="1"
                      Style="{StaticResource FilterComboBoxStyle}"
                      Margin="0,0,12,0"
                      SelectedIndex="0">

                <ComboBoxItem Content="All types"/>
                <ComboBoxItem Content="Laptop"/>
                <ComboBoxItem Content="Desktop"/>
                <ComboBoxItem Content="Monitor"/>
                <ComboBoxItem Content="Mobile Phone"/>
                <ComboBoxItem Content="Tablet"/>
                <ComboBoxItem Content="Keyboard"/>
                <ComboBoxItem Content="Headset"/>
                <ComboBoxItem Content="Printer"/>
                <ComboBoxItem Content="Server"/>
                <ComboBoxItem Content="Network Device"/>

            </ComboBox>

            <!-- Status filter -->
            <ComboBox x:Name="StatusFilterComboBox"
                      Grid.Column="2"
                      Style="{StaticResource FilterComboBoxStyle}"
                      Margin="0,0,12,0"
                      SelectedIndex="0">

                <ComboBoxItem Content="All statuses"/>
                <ComboBoxItem Content="Available"/>
                <ComboBoxItem Content="Assigned"/>
                <ComboBoxItem Content="In Repair"/>
                <ComboBoxItem Content="Broken"/>
                <ComboBoxItem Content="Lost"/>
                <ComboBoxItem Content="Retired"/>

            </ComboBox>

            <!-- Add Asset -->
            <Button x:Name="AddAssetButton"
                    Grid.Column="4"
                    Style="{StaticResource PrimaryButtonStyle}">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Add Asset"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

        <!-- Table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">

            <Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">

                    <DataGrid x:Name="AssetsGrid"
                              MinWidth="1800"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="True"
                              Visibility ="Visible"
                              IsReadOnly="True"
                              RowHeight="48"
                              AlternationCount="2"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="White"
                              GridLinesVisibility="Vertical"
                              VerticalGridLinesBrush="#E5E7EB"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ClipboardCopyMode="IncludeHeader"
                              ColumnHeaderStyle="{StaticResource ModernHeaderStyle}"
                              CellStyle="{StaticResource ModernCellStyle}"
                              RowStyle="{StaticResource ModernRowStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Asset Tag"
                                                Binding="{Binding AssetTag}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="AssetTag"
                                                CanUserSort="True"
                                                Width="130"/>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding Type}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="Type"
                                                CanUserSort="True"
                                                Width="130"/>

                            <DataGridTextColumn Header="Brand"
                                                Binding="{Binding Brand}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="Brand"
                                                CanUserSort="True"
                                                Width="140"/>

                            <DataGridTextColumn Header="Model"
                                                Binding="{Binding Model}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="Model"
                                                CanUserSort="True"
                                                Width="190"/>

                            <DataGridTextColumn Header="Serial Number"
                                                Binding="{Binding SerialNumber}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="SerialNumber"
                                                CanUserSort="True"
                                                Width="180"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="Status"
                                                CanUserSort="True"
                                                Width="130"/>

                            <DataGridTextColumn Header="Assigned To"
                                                Binding="{Binding AssignedTo}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="AssignedTo"
                                                CanUserSort="True"
                                                Width="180"/>

                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                SortMemberPath="Department"
                                                CanUserSort="True"
                                                Width="160"/>

                            <DataGridTextColumn Header="Purchase Date"
                                                Binding="{Binding PurchaseDate,
                                                                  StringFormat={}{0:yyyy-MM-dd}}"
                                                SortMemberPath="PurchaseDate"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                CanUserSort="True"
                                                Width="150"/>

                            <DataGridTextColumn Header="Warranty Expires"
                                                Binding="{Binding WarrantyExpires,
                                                                  StringFormat={}{0:yyyy-MM-dd}}"
                                                SortMemberPath="WarrantyExpires"
                                                CanUserSort="True"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="170"/>

                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding Location}"
                                                SortMemberPath="Location"
                                                CanUserSort="True"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="200"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyStatePanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="34"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="EmptyStateTitle"
                               Text="No assets found"
                               Margin="0,14,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="EmptyStateMessage"
                               Text="Add your first asset to get started."
                               Margin="0,6,0,0"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- Loading state -->
                <TextBlock x:Name="LoadingStateText"
                           Text="Loading assets..."
                           Visibility="Collapsed"
                           FontSize="15"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <Border x:Name="SuccessToast"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,20,0"
            Padding="16,12"
            Background="#DCFCE7"
            BorderBrush="#86EFAC"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed"
            Panel.ZIndex="100">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#15803D"
                   Margin="0,0,10,0"/>

                <TextBlock x:Name="SuccessToastText"
                   Text="Asset added successfully"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#166534"
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>

</Page>