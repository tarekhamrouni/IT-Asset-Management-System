<Page x:Class="IT_Asset_Management_System.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="DashboardGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="35">

            <!-- Header -->
            <TextBlock Text="Dashboard"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="Overview of your company assets"
                       Margin="0,6,0,18"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,28"/>

            <!-- Statistic cards -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Total Assets"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TotalAssetsText"
                                   Text="0"
                                   Margin="0,10,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="3,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Available"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="AvailableAssetsText"
                                   Text="0"
                                   Margin="0,10,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="6,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Assigned"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="AssignedAssetsText"
                                   Text="0"
                                   Margin="0,10,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="In Repair"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="RepairAssetsText"
                                   Text="0"
                                   Margin="0,10,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dashboard tables -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent assets -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="22"
                        Margin="0,0,10,0">

                    <StackPanel>
                        <TextBlock Text="Recent Assets"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,18"/>

                        <DataGrid x:Name="RecentAssetsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="330"
                                  RowHeight="42"
                                  BorderThickness="0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource DashboardGridHeaderStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  AlternationCount="2"
                                  AlternatingRowBackground="{DynamicResource AlternatingSurfaceBrush}"
                                  RowBackground="{DynamicResource SurfaceBrush}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Asset ID"
                                                    Binding="{Binding AssetTag}"
                                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Brand"
                                                    Binding="{Binding Brand}"
                                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Model"
                                                    Binding="{Binding Model}"
                                                    Width="1.6*"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Warranty warnings -->
                <Border Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="22"
                        Margin="10,0,0,0">

                    <StackPanel>
                        <TextBlock Text="Warranty Warnings"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="Expiring within 90 days"
                                   Margin="0,5,0,18"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <DataGrid x:Name="WarrantyGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="330"
                                  RowHeight="42"
                                  BorderThickness="0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource DashboardGridHeaderStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  AlternationCount="2"
                                  AlternatingRowBackground="{DynamicResource AlternatingSurfaceBrush}"
                                  RowBackground="{DynamicResource SurfaceBrush}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Asset"
                                                    Binding="{Binding AssetTag}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Expires"
                                                    Binding="{Binding WarrantyExpires}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>