<Window x:Class="IT_Asset_Management_System.Views.AddAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Asset"
        Width="720"
        Height="650"
        MinWidth="650"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="#660F172A">

    <Window.Resources>

        <!-- Text input -->
        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- Dropdown -->
        <Style x:Key="FormComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- Date selector -->
        <Style x:Key="FormDatePickerStyle"
               TargetType="DatePicker">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>

    </Window.Resources>
    <Border Background="#F5F7FA"
        CornerRadius="14"
        BorderBrush="#CBD5E1"
        BorderThickness="1">
        
        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Add New Asset"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Enter the information for the new company asset."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#6B7280"/>
            </StackPanel>

            <!-- Form card -->
            <Border Grid.Row="2"
                    Padding="24"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Type -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">
                            <TextBlock Text="Asset Type *"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <ComboBox x:Name="TypeComboBox"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Asset tag -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">
                            <TextBlock Text="Asset Tag"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="AssetTagTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"
                                     Background="#F3F4F6"
                                     Foreground="#4B5563"/>
                        </StackPanel>

                        <!-- Brand -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">
                            <TextBlock Text="Brand *"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="BrandTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Model -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">
                            <TextBlock Text="Model *"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="ModelTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Serial number -->
                        <StackPanel Grid.Row="4"
                                    Grid.Column="0">
                            <TextBlock Text="Serial Number"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="SerialNumberTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">
                            <TextBlock Text="Status *"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <ComboBox x:Name="StatusComboBox"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Department -->
                        <StackPanel Grid.Row="6"
                                    Grid.Column="0">
                            <TextBlock Text="Department"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="DepartmentTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Assigned to -->
                        <StackPanel Grid.Row="6"
                                    Grid.Column="2">
                            <TextBlock Text="Assigned To"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="AssignedToTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Purchase date -->
                        <StackPanel Grid.Row="8"
                                    Grid.Column="0">
                            <TextBlock Text="Purchase Date"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <DatePicker x:Name="PurchaseDatePicker"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>

                        <!-- Warranty -->
                        <StackPanel Grid.Row="8"
                                    Grid.Column="2">
                            <TextBlock Text="Warranty Expiry"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <DatePicker x:Name="WarrantyExpiryDatePicker"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        

            <!-- Buttons -->
            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#DC2626"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Content="Cancel"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Width="125"
                        Height="40"
                        Content="Save Asset"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </Grid>

        </Grid>
    </Border>
</Window>